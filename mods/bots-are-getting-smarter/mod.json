{
  "id": "bots-are-getting-smarter",
  "name": "Bots Are Getting Smarter",
  "version": "2.0.0",
  "author": "Modatorial",
  "description": "4-layer neural net that learns bot behaviour live and plays back with a trained policy. No Python, no install — trains in your browser.",
  "gameVersion": 25,
  "main": "main.js",
  "settings": [
    {
      "id": "captureEnabled",
      "type": "toggle",
      "label": "Capture bot decisions",
      "default": true
    },
    {
      "id": "trainEnabled",
      "type": "toggle",
      "label": "Train the network live",
      "default": true
    },
    {
      "id": "applyPolicy",
      "type": "toggle",
      "label": "Bots use the trained policy",
      "description": "Off = pure capture mode. On = bots use the net.",
      "default": false
    },
    {
      "id": "learningRate",
      "type": "slider",
      "label": "Learning rate (×0.001)",
      "min": 1, "max": 50, "step": 1, "default": 3
    },
    {
      "id": "showHud",
      "type": "toggle",
      "label": "Show AI HUD",
      "default": true
    },
    {
      "id": "resetNetwork",
      "type": "button",
      "label": "Reset network",
      "buttonLabel": "Reset weights & buffer"
    }
  ]
}